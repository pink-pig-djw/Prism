# 以下全部可选。不配置时，用户在网页「设置 → 模型服务」里填写自己的 API Key 即可。
# 配置后，服务器会用这里的 Key 代为请求（此时网页端的 Base URL 会被忽略）。

# OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / Moonshot / Ollama / OpenRouter ...）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-5.5,gpt-5.4-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# 部署到公网并配置了上面的服务器 Key 时，强烈建议设置访问密码，防止被他人盗用额度
ACCESS_CODE=
